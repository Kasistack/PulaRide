<?xml version="1.0" encoding="utf-8"?>
<!--
  Device-to-device / cloud data extraction rules. Mirrors backup_rules: nothing
  sensitive is shared. Keep allowBackup=false in the manifest as the primary guard.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- No includes => nothing extracted to cloud backup. -->
    </cloud-backup>
    <device-transfer>
        <!-- No includes => nothing transferred between devices. -->
    </device-transfer>
</data-extraction-rules>
